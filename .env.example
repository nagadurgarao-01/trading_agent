# Environment & Broker Config
ENV=paper # "paper" or "live"
BROKER_TYPE=dhan # "paper" or "dhan"
LIVE_TRADING_ENABLED=false
ALLOW_SHORT_SELLING=false
DHAN_CLIENT_ID=your_dhan_client_id_here
DHAN_ACCESS_TOKEN=your_dhan_access_token_here

# LLM & Sentiment Config
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-1.5-flash

# Dashboard Authentication Secrets (REQUIRED FOR PRODUCTION)
DASHBOARD_USER=admin
DASHBOARD_PASS=your_strong_custom_password_here
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
